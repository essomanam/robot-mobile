<?xml version="1.0"?>
<!--
  TurtleBot3 Waffle + caméra RGB-D : modèle pour Gazebo (physique et capteurs).

  Dérivé de turtlebot3_gazebo/models/turtlebot3_waffle/model.sdf (ROBOTIS, Apache-2.0).
  Différences, justifiées dans docs/etapes/E1_simulation.md :
    1. Caméra couleur remplacée par une caméra RGB-D (rgbd_camera), images publiées
       dans le repère optique camera_rgb_optical_frame.
    2. Repère du modèle = base_footprint posé au sol, comme dans l'URDF : tous les
       autres liens sont décalés de +0.010 m (hauteur de base_link). Le modèle
       d'origine plaçait base_footprint 1 cm au-dessus du sol.
    3. Repère explicite pour l'IMU (frame_id) et masses explicites pour les
       liens sans inertie (sinon Gazebo leur attribue 1 kg par défaut).
    4. Publication de la vérité terrain de position (OdometryPublisher).

  Les positions doivent rester identiques à celles de
  robot_mobile_description/urdf/robot_mobile.urdf.xacro.
-->
<sdf version="1.12">
  <model name="robot_mobile">

    <link name="base_footprint">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <link name="base_link">
      <pose>0 0 0.010 0 0 0</pose>
      <inertial>
        <pose>-0.064 0 0.048 0 0 0</pose>
        <mass>1.3729096</mass>
        <inertia>
          <ixx>4.2111447e-02</ixx><iyy>4.2111447e-02</iyy><izz>7.5254874e-02</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>-0.064 0 0.048 0 0 0</pose>
        <geometry>
          <box><size>0.265 0.265 0.089</size></box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>-0.064 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/bases/waffle_base.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="imu_link">
      <pose>0 0 0.078 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu</topic>
        <frame_id>imu_link</frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- LiDAR LDS : 360 mesures par tour, 10 Hz, 0,12 à 3,5 m -->
    <link name="base_scan">
      <pose>-0.064 0 0.132 0 0 0</pose>
      <inertial>
        <pose>0.012 0 -0.021 0 0 0</pose>
        <mass>0.114</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <pose>0.012 0 -0.021 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.0508</radius><length>0.055</length></cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/sensors/lds.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <frame_id>base_scan</frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.144 0.033 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.1175580e-05</ixx><iyy>1.1192413e-05</iyy><izz>2.0712558e-05</izz>
          <ixy>-4.2369783e-11</ixy><ixz>-5.9381719e-09</ixz><iyz>-1.4400107e-11</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <geometry>
          <cylinder><radius>0.033</radius><length>0.018</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>100000</mu><mu2>100000</mu2><fdir1>0 0 0</fdir1><slip1>0</slip1><slip2>0</slip2></ode>
          </friction>
          <contact>
            <ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/wheels/left_tire.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>0 -0.144 0.033 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.1175580e-05</ixx><iyy>1.1192413e-05</iyy><izz>2.0712558e-05</izz>
          <ixy>-4.2369783e-11</ixy><ixz>-5.9381719e-09</ixz><iyz>-1.4400107e-11</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <geometry>
          <cylinder><radius>0.033</radius><length>0.018</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>100000</mu><mu2>100000</mu2><fdir1>0 0 0</fdir1><slip1>0</slip1><slip2>0</slip2></ode>
          </friction>
          <contact>
            <ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/wheels/right_tire.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="caster_back_left_link">
      <pose>-0.177 0.064 0.006 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.005</radius></sphere>
        </geometry>
        <surface>
          <contact>
            <ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="caster_back_right_link">
      <pose>-0.177 -0.064 0.006 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.005</radius></sphere>
        </geometry>
        <surface>
          <contact>
            <ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
    </link>

    <!--
      Caméra RGB-D, paramètres inspirés d'une Intel RealSense D435 :
      640 x 480 pixels, champ horizontal 69,4° (1,2112 rad), 15 images/s.
      Le capteur regarde selon l'axe x du lien (convention Gazebo) ; les images
      sont horodatées dans le repère optique (convention ROS) via frame_id.
      La profondeur est produite par le même capteur, donc déjà recalée sur la couleur.
    -->
    <link name="camera_rgb_frame">
      <pose>0.069 -0.047 0.117 0 0 0</pose>
      <inertial>
        <mass>0.035</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>camera/rgbd</topic>
        <frame_id>camera_rgb_optical_frame</frame_id>
        <camera name="rgbd">
          <horizontal_fov>1.2112</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.2</near>
              <far>8.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <joint name="scan_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_rgb_frame</child>
    </joint>

    <!-- Axe des roues : z du repère du joint (= repère de la roue) -->
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>20</effort></limit>
      </axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>20</effort></limit>
      </axis>
    </joint>

    <joint name="caster_back_left_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_back_left_link</child>
    </joint>

    <joint name="caster_back_right_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_back_right_link</child>
    </joint>

    <!-- Entraînement différentiel : reçoit /cmd_vel, publie /odom et odom -> base_footprint -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.287</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>

    <!-- Vérité terrain : position exacte du robot dans le monde (sert à évaluer le SLAM, E2) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>ground_truth/odom</odom_topic>
      <tf_topic>ground_truth/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
