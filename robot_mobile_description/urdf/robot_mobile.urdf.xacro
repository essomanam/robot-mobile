<?xml version="1.0"?>
<!--
  TurtleBot3 Waffle + caméra RGB-D : description pour ROS (robot_state_publisher, RViz).

  Dérivé de turtlebot3_gazebo/urdf/turtlebot3_waffle.urdf (ROBOTIS, Apache-2.0).
  Différences :
    - la profondeur est recalée sur l'image couleur (même capteur simulé) : un seul
      repère optique, camera_rgb_optical_frame, pour la couleur ET la profondeur ;
    - les rotations des repères optiques valent exactement pi/2 (et non 1.57).

  Le modèle Gazebo correspondant est models/robot_mobile/model.sdf : toute position
  modifiée ici doit l'être aussi là-bas (voir docs/etapes/E1_simulation.md).
-->
<robot name="robot_mobile" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="meshes" value="package://turtlebot3_gazebo/models/turtlebot3_common/meshes"/>

  <!-- Position de la caméra (support d'origine de la RealSense du Waffle), en mètres -->
  <xacro:property name="camera_x" value="0.064"/>
  <xacro:property name="camera_y" value="-0.065"/>
  <xacro:property name="camera_z" value="0.094"/>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${meshes}/bases/waffle_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>
    <collision>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry>
        <box size="0.266 0.266 0.094"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.3729096"/>
      <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
               iyy="8.6195418e-03" iyz="-3.5422299e-06" izz="1.4612727e-02"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side y mesh">
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0.023" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_${side}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="${meshes}/wheels/${mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.018" radius="0.033"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.8498940e-02"/>
        <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
                 iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel side="left" y="0.144" mesh="left_tire.stl"/>
  <xacro:wheel side="right" y="-0.144" mesh="right_tire.stl"/>

  <xacro:macro name="caster" params="side y">
    <joint name="caster_back_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_back_${side}_link"/>
      <origin xyz="-0.177 ${y} -0.004" rpy="${-pi/2} 0 0"/>
    </joint>
    <link name="caster_back_${side}_link">
      <collision>
        <origin xyz="0 0.001 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.030 0.009 0.020"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:caster side="left" y="0.064"/>
  <xacro:caster side="right" y="-0.064"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <geometry>
        <mesh filename="${meshes}/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="${meshes}/sensors/r200.dae"/>
      </geometry>
    </visual>
  </link>

  <!-- Centre optique de la caméra : x vers l'avant (convention robot) -->
  <joint name="camera_rgb_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
    <origin xyz="0.005 0.018 0.013" rpy="0 0 0"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <!-- Repère optique : z vers l'avant, x à droite, y vers le bas (REP 103).
       Les images couleur et profondeur sont exprimées dans ce repère. -->
  <joint name="camera_rgb_optical_joint" type="fixed">
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

</robot>
