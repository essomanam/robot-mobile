Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Color: 160; 160; 164
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Value: true
    - Class: rviz_default_plugins/DepthCloud
      Name: DepthCloud
      Enabled: true
      Depth Map Topic: /camera/depth/image_raw
      Color Image Topic: /camera/color/image_raw
      Depth Map Transport Hint: raw
      Color Transport Hint: raw
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Occlusion Compensation:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (roues)
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 120; 0
        Alpha: 1
        Shaft Length: 0.2
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Image couleur
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Image profondeur
      Enabled: true
      Topic:
        Value: /camera/depth/image_raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Normalize Range: false
      Min Value: 0
      Max Value: 8
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Focal Point:
        X: 1.5
        Y: 1
        Z: 0
      Pitch: 0.9
      Yaw: 3.9
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Height: 900
  Width: 1400
