<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_mobile_bringup</name>
  <version>0.1.0</version>
  <description>Lancement du projet AS52 : mondes Gazebo, pont ROS 2, SLAM, configurations RViz et de lancement.</description>
  <maintainer email="manganmanasamuel@gmail.com">essomanam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_mobile_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <!-- trajectoire de référence et enregistrement des essais -->
  <exec_depend>robot_mobile_evaluation</exec_depend>
  <!-- navigation guidée par la vision (E3) -->
  <exec_depend>robot_mobile_perception</exec_depend>
  <exec_depend>robot_mobile_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
